generator client {
  provider   = "prisma-client"
  output     = "./generated"
  engineType = "client"
  runtime    = "bun"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (better-auth core + admin plugin)
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  employeeNo    String?   @unique
  name          String
  email         String    @unique
  phone         String?
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("LEADER")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  incoming          Incoming[]    @relation("IncomingCreator")
  requests          Request[]     @relation("RequestLeader")
  adminRequests     Request[]     @relation("RequestAdmin")
  directorRequests  Request[]     @relation("RequestDirector")
  deliveryNotes     DeliveryNote[] @relation("DeliveryCreator")
  turnovers         Turnover[]    @relation("TurnoverSubmitter")
  verifiedTurnovers Turnover[]    @relation("TurnoverVerifier")
  auditLogs         AuditLog[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  issuer                String?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  company   String?
  contact   String?
  phone     String?
  email     String?
  address   String?
  note      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests Request[]

  @@index([name])
  @@map("customer")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    Item[]
  incoming Incoming[]

  @@map("supplier")
}

model ItemCategory {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String   @unique
  lastNumber Int      @default(0)
  isActive   Boolean  @default(true)
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items Item[]

  @@map("item_category")
}

model Item {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  categoryId       String
  brand            String?
  size             String?
  unit             String
  stockGudang      Int      @default(0)
  stockOperasional Int      @default(0)
  onRequest        Int      @default(0)
  minStock         Int      @default(0)
  supplierId       String?
  isActive         Boolean  @default(true)
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category       ItemCategory      @relation(fields: [categoryId], references: [id])
  supplier       Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  incomingItems  IncomingItem[]
  requestItems   RequestItem[]
  deliveryItems  DeliveryNoteItem[]
  turnoverItems  TurnoverItem[]

  @@index([supplierId])
  @@index([categoryId])
  @@map("item")
}

model Incoming {
  id           String   @id @default(cuid())
  number       String   @unique
  receivedAt   DateTime @default(now())
  supplierId   String
  documentNo   String?
  note         String?
  createdById  String
  createdAt    DateTime @default(now())

  supplier  Supplier       @relation(fields: [supplierId], references: [id])
  createdBy User           @relation("IncomingCreator", fields: [createdById], references: [id])
  items     IncomingItem[]

  @@index([supplierId])
  @@index([receivedAt])
  @@map("incoming")
}

model IncomingItem {
  id         String @id @default(cuid())
  incomingId String
  itemId     String
  qty        Int

  incoming Incoming @relation(fields: [incomingId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id])

  @@index([incomingId])
  @@index([itemId])
  @@map("incoming_item")
}

model Request {
  id              String   @id @default(cuid())
  number          String   @unique
  poNo            String
  site            String
  customerId      String?
  neededAt        DateTime
  estimatedDoneAt DateTime?
  note            String?
  status          String   @default("PENDING_ADMIN")
  leaderId        String
  adminId         String?
  directorId      String?
  adminNote       String?
  directorNote    String?
  decidedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  leader     User          @relation("RequestLeader", fields: [leaderId], references: [id])
  admin      User?         @relation("RequestAdmin", fields: [adminId], references: [id])
  director   User?         @relation("RequestDirector", fields: [directorId], references: [id])
  customer   Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items      RequestItem[]
  delivery   DeliveryNote?

  @@index([customerId])
  @@index([leaderId])
  @@index([status])
  @@map("request")
}

model RequestItem {
  id        String @id @default(cuid())
  requestId String
  itemId    String
  qty       Int

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [itemId], references: [id])

  @@index([requestId])
  @@index([itemId])
  @@map("request_item")
}

model DeliveryNote {
  id          String    @id @default(cuid())
  number      String    @unique
  requestId   String    @unique
  status      String    @default("ISSUED")
  vehicle     String?
  issuedAt    DateTime  @default(now())
  confirmedAt DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  request   Request            @relation(fields: [requestId], references: [id])
  createdBy User               @relation("DeliveryCreator", fields: [createdById], references: [id])
  items     DeliveryNoteItem[]
  turnover  Turnover?

  @@index([status])
  @@map("delivery_note")
}

model DeliveryNoteItem {
  id             String @id @default(cuid())
  deliveryNoteId String
  itemId         String
  qty            Int
  boxes          String?

  deliveryNote DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  item         Item         @relation(fields: [itemId], references: [id])

  @@index([deliveryNoteId])
  @@index([itemId])
  @@map("delivery_note_item")
}

model Turnover {
  id             String    @id @default(cuid())
  deliveryNoteId String    @unique
  status         String    @default("DRAFT")
  note           String?
  submittedById  String
  submittedAt    DateTime?
  verifiedById   String?
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  deliveryNote DeliveryNote   @relation(fields: [deliveryNoteId], references: [id])
  submittedBy  User           @relation("TurnoverSubmitter", fields: [submittedById], references: [id])
  verifiedBy   User?          @relation("TurnoverVerifier", fields: [verifiedById], references: [id])
  items        TurnoverItem[]

  @@index([status])
  @@map("turnover")
}

model TurnoverItem {
  id         String @id @default(cuid())
  turnoverId String
  itemId     String
  brought    Int
  used       Int    @default(0)
  returned   Int    @default(0)
  damaged    Int    @default(0)

  turnover Turnover @relation(fields: [turnoverId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id])

  @@index([turnoverId])
  @@index([itemId])
  @@map("turnover_item")
}

model Notification {
  id         String   @id @default(cuid())
  channel    String   @default("WHATSAPP")
  target     String
  targetName String?
  role       String?
  subject    String
  message    String
  status     String   @default("PENDING")
  error      String?
  entity     String?
  entityId   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("notification")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  meta      String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity])
  @@map("audit_log")
}
